# Generated by bolt — do not edit manually
image:
  repository: images.releases.hashicorp.com
  name: hashicorp/terraform-enterprise
  tag: "{{ .ImageTag }}"

imagePullSecrets:
  - name: tfe-image-pull

tls:
  certificateSecret: tfe-tls

service:
  type: LoadBalancer
  port: 443
  annotations: {}

env:
  variables:
    TFE_HOSTNAME: "{{ .Hostname }}"
    TFE_OPERATIONAL_MODE: "external"
    TFE_OBJECT_STORAGE_TYPE: "s3"
  secretRefs:
    - name: tfe-secrets
    - name: tfe-storage
